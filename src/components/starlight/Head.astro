---
import BaseHead from "../BaseHead.astro";

const { title, description, image } = Astro.locals.starlightRoute.entry.data;
---

<style>
  * {
    --width: auto;
  }
</style>

<BaseHead
  title={title}
  description={description ?? title}
  image={image}
/>

<style>
  body {
    --width: auto;
  }
</style>
