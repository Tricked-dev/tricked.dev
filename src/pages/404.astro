---
import { SITE_TITLE } from "../config";
import Layout from "../layouts/Layout.astro";

const title = `404 - ${SITE_TITLE}`;
---

<Layout title={title} description="The requested page could not be found.">
  <section class="error-stage" aria-labelledby="not-found-title">
    <div class="error-panel">
      <div class="error-vertical" lang="ja">エラーポータル</div>
      <div>
        <div class="error-code">ERR // 404</div>
        <h1 id="not-found-title" class="error-title" lang="ja">
          ページが見つかりません
        </h1>
        <div class="error-rule"></div>
        <p>The page you requested does not exist or has moved.</p>
        <a href="/" class="btn btn-primary mt-6">← Return home</a>
      </div>
    </div>
  </section>
</Layout>
